# Environment variables for depoy/docker-compose-fundament.yml.

# PostgreSQL service settings.
POSTGRES_DB=tradeagent
POSTGRES_USER=tradeagent
POSTGRES_PASSWORD=tradeagent
POSTGRES_PORT=5432

# RabbitMQ service settings.
RABBITMQ_DEFAULT_USER=tradeagent
RABBITMQ_DEFAULT_PASS=tradeagent
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Redis service settings.
REDIS_PASSWORD=tradeagent
REDIS_PORT=6379
